# ==============================================================================
# Shared Node.js + Express + MongoDB Backend Environment Configuration
# Copy to backend/.env and fill in real values before starting.
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB (Same database used by User Mobile App; set USE_LOCAL_EMBEDDED_DB=true only for local dev without MongoDB)
USE_LOCAL_EMBEDDED_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017/doc_scanner_saas

# JWT Configuration (Admin tokens must use dedicated Admin secret or strict role claim)
JWT_ADMIN_ACCESS_SECRET=change_me_admin_access_secret_min_32_chars
JWT_ADMIN_REFRESH_SECRET=change_me_admin_refresh_secret_min_32_chars
JWT_ADMIN_ACCESS_EXPIRES_IN=15m
JWT_ADMIN_REFRESH_EXPIRES_IN=7d

# Single Platform Admin Seed Credentials (No Admin Registration endpoint exists)
ADMIN_EMAIL=admin@docscanner.example
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=ChangeMe!StrongAdminPass2026

# CORS Origins (Admin Website)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP / Email for Admin Password Reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FIC Locker Admin <no-reply@ficlocker.local>"
ADMIN_WEB_URL=http://localhost:5173

# Private Cloud Object Storage (AWS S3 or S3-compatible private bucket)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=doc-scanner-private-storage
S3_ENDPOINT=
S3_PRESIGNED_TTL_SECONDS=120

# Payment Provider (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Website & Mobile Client URLs
VITE_API_BASE_URL=http://localhost:5000/api/v1

