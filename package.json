{
  "name": "document-scanner-saas",
  "version": "1.0.0",
  "private": true,
  "description": "FIC Locker — Admin Website, Admin Mobile App, and Shared Backend",
  "workspaces": [
    "packages/*",
    "backend",
    "Admin"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:web": "npm --workspace=Admin run dev",
    "start:mobile": "npm --prefix Admin_Mobile start",
    "build:types": "npm --workspace=packages/shared-types run build",
    "build:backend": "npm --workspace=backend run build",
    "build:web": "npm --workspace=Admin run build",
    "test:backend": "npm --workspace=backend test",
    "seed:admin": "npm --workspace=backend run seed:admin"
  }
}
