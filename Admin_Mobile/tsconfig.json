{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2022"],
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": [
      "../node_modules/@types",
      "../User/node_modules/@types"
    ],
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react/jsx-runtime": ["../node_modules/@types/react/jsx-runtime"],
      "*": [
        "*",
        "../User/node_modules/*",
        "../node_modules/*"
      ]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.js", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "__tests__", "babel.config.js", "metro.config.js", "jest.config.js"]
}
